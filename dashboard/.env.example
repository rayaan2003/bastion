# Password for the dashboard UI login (/login).
DASHBOARD_PASSWORD=change-me

# Signs the browser session cookie after login. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SESSION_SECRET=change-me-too

# Bearer token the Python SDK (dashboard_audit_sink, DashboardApprovalHandler)
# sends as `Authorization: Bearer <key>`. Generate the same way.
DASHBOARD_API_KEY=change-me-as-well
